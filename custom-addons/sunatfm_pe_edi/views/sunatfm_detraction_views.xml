<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sunatfm_pe_detraction_view_list" model="ir.ui.view">
        <field name="name">sunatfm.pe.detraction.list</field>
        <field name="model">sunatfm.pe.detraction</field>
        <field name="arch" type="xml">
            <list>
                <field name="annex"/>
                <field name="code"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="minimum_amount"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sunatfm_pe_detraction_view_form" model="ir.ui.view">
        <field name="name">sunatfm.pe.detraction.form</field>
        <field name="model">sunatfm.pe.detraction</field>
        <field name="arch" type="xml">
            <form string="Detracción SUNAT">
                <sheet>
                    <group>
                        <field name="annex"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="rate"/>
                        <field name="minimum_amount"/>
                        <field name="currency_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sunatfm_pe_detraction_action" model="ir.actions.act_window">
        <field name="name">Detracciones SUNAT</field>
        <field name="res_model">sunatfm.pe.detraction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

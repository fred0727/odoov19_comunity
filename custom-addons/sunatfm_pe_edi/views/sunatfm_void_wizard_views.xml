<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sunatfm_pe_edi_void_wizard_form" model="ir.ui.view">
        <field name="name">sunatfm.pe.edi.void.wizard.form</field>
        <field name="model">sunatfm.pe.edi.void.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular comprobante">
                <group>
                    <field name="account_move_id"/>
                    <field name="reason" placeholder="Ej.: Error en los datos del comprobante"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Se enviará una Comunicación de Baja a SUNAT. Luego consulte el estado del ticket hasta recibir el CDR.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Solicitar baja a SUNAT" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sunatfm_pe_edi_configuration_view_list" model="ir.ui.view">
        <field name="name">sunatfm.pe.edi.configuration.list</field>
        <field name="model">sunatfm.pe.edi.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="cpe_enabled"/>
                <field name="gre_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="sunatfm_pe_edi_configuration_view_form" model="ir.ui.view">
        <field name="name">sunatfm.pe.edi.configuration.form</field>
        <field name="model">sunatfm.pe.edi.configuration</field>
        <field name="arch" type="xml">
            <form string="Configuración EDI SUNAT">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Esta es la base de una integración propia. No realiza envíos ni almacena credenciales todavía.
                    </div>
                    <group>
                        <group string="Empresa">
                            <field name="company_id"/>
                            <field name="establishment_code"/>
                            <field name="active"/>
                        </group>
                        <group string="Entorno y alcance">
                            <field name="environment"/>
                            <field name="service_endpoint" readonly="1"/>
                            <field name="cpe_enabled"/>
                            <field name="gre_enabled"/>
                        </group>
                    </group>
                    <group string="Acceso SUNAT (Pruebas / Producción)" groups="base.group_system">
                        <field name="certificate_p12" filename="certificate_filename"/>
                        <field name="certificate_filename" invisible="1"/>
                        <field name="certificate_password" password="True"/>
                        <field name="sol_user"/>
                        <field name="sol_password" password="True"/>
                        <button name="action_validate_certificate" type="object" string="Validar certificado" class="btn-secondary"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Las credenciales se guardan en la base de datos y solo son visibles para administradores. Verifique el ambiente seleccionado antes de enviar.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sunatfm_pe_edi_configuration_action" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">sunatfm.pe.edi.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

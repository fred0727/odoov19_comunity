<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_sale_description" model="ir.ui.view">
        <field name="name">sale.order.form.sale.description</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//field[@name='tag_ids']" position="after">
                <field name="sale_description"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_tree_sale_description" model="ir.ui.view">
        <field name="name">sale.order.list.sale.description</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="sale_description" string="Descripción" optional="show"/>
            </field>
        </field>
    </record>
</odoo>

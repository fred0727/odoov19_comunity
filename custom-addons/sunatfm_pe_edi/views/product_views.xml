<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sunatfm_pe_edi_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.sunatfm.edi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Facturación SUNAT" name="sunatfm_edi_product_group">
                    <field name="sunatfm_edi_sku"/>
                    <field name="sunatfm_edi_detraction_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

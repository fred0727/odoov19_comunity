<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sunatfm_vehicle_view_list" model="ir.ui.view">
        <field name="name">sunatfm.pe.vehicle.list</field>
        <field name="model">sunatfm.pe.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="driver_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sunatfm_vehicle_view_form" model="ir.ui.view">
        <field name="name">sunatfm.pe.vehicle.form</field>
        <field name="model">sunatfm.pe.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehículo GRE SUNAT">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="brand"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="driver_id"/>
                            <field name="driver_license"/>
                            <field name="mtc_registration"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sunatfm_vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehículos GRE SUNAT</field>
        <field name="res_model">sunatfm.pe.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
